compatibility_level = 3.6
myhostname = mail.vercuno.com.br
mydomain = vercuno.com.br
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination =
relay_domains =
mynetworks = 127.0.0.0/8, 172.31.242.2/32
smtpd_relay_restrictions = permit_mynetworks, reject
smtpd_recipient_restrictions = permit_mynetworks, reject
smtpd_tls_security_level = none
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6
minimal_backoff_time = 120s
maximal_backoff_time = 1800s
default_process_limit = 12
smtp_destination_concurrency_limit = 3
message_size_limit = 37748736
maillog_file = /dev/stdout
